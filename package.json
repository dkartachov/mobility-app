{
  "name": "plie",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-video": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "cross-env APP_VARIANT=development expo start",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "build:dev": "npm run doctor && npx eas-cli@latest build --platform android --profile development",
    "build:preview": "npm run doctor && npx eas-cli@latest build --platform android --profile preview",
    "build:prod": "npm run doctor && npx eas-cli@latest build --platform android --profile production",
    "update:dev": "cross-env APP_VARIANT=development npx eas-cli@latest update --channel development --environment development --platform android",
    "update:preview": "npx eas-cli@latest update --channel preview --environment production --platform android",
    "update:prod": "npx eas-cli@latest update --channel production --environment production --platform android",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
