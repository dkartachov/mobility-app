{
  "name": "mobility-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.21",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "expo-video": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "android": "APP_VARIANT=development expo start --android",
    "ios": "APP_VARIANT=development expo start --ios",
    "lint": "expo lint",
    "build:dev": "npx eas-cli@latest build --profile development",
    "build:preview": "npx eas-cli@latest build --profile preview",
    "build:prod": "npx eas-cli@latest build --profile production",
    "update:dev": "APP_VARIANT=development npx eas-cli@latest update --channel development --environment development --platform android",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview --platform android",
    "update:prod": "npx eas-cli@latest update --channel production --environment production --platform android",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
